<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cases inspired by the test suites of other reasoners. The ontologies were
  re-formulated for Konclude and their expected taxonomies were reviewed by
  hand; kt:inspiredBy records the source of the idea (no files are vendored).
-->
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
          ontologyIRI="http://konclude.test/suite/inspired">
  <Prefix name="kt" IRI="http://konclude.test/vocabulary#"/>

  <ClassAssertion><Class abbreviatedIRI="kt:TestSuite"/><NamedIndividual abbreviatedIRI="kt:suite-inspired"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteName"/><NamedIndividual abbreviatedIRI="kt:suite-inspired"/><Literal>Inspired-examples</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:suiteDirectory"/><NamedIndividual abbreviatedIRI="kt:suite-inspired"/><Literal>inspired</Literal></DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:ClassClassificationTest"/><NamedIndividual abbreviatedIRI="kt:inspired-elk-roles"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:inspired-elk-roles"/><Literal>class-classification</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:inspired-elk-roles"/><Literal>elk-roles.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:inspired-elk-roles"/><Literal>expected/elk-roles-classification.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:inspiredBy"/><NamedIndividual abbreviatedIRI="kt:inspired-elk-roles"/><Literal>ELK: PropertyCompositionsWithHierarchy</Literal></DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:description"/>
    <NamedIndividual abbreviatedIRI="kt:inspired-elk-roles"/>
    <Literal>A is subsumed by X through the role chain r o s -> t.</Literal>
  </DataPropertyAssertion>

  <ClassAssertion><Class abbreviatedIRI="kt:ClassClassificationTest"/><NamedIndividual abbreviatedIRI="kt:inspired-pizza"/></ClassAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:task"/><NamedIndividual abbreviatedIRI="kt:inspired-pizza"/><Literal>class-classification</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:usesOntology"/><NamedIndividual abbreviatedIRI="kt:inspired-pizza"/><Literal>pizza.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:expectedFile"/><NamedIndividual abbreviatedIRI="kt:inspired-pizza"/><Literal>expected/pizza-classification.owl.xml</Literal></DataPropertyAssertion>
  <DataPropertyAssertion><DataProperty abbreviatedIRI="kt:inspiredBy"/><NamedIndividual abbreviatedIRI="kt:inspired-pizza"/><Literal>HermiT examples: pizza.owl</Literal></DataPropertyAssertion>
  <DataPropertyAssertion>
    <DataProperty abbreviatedIRI="kt:description"/>
    <NamedIndividual abbreviatedIRI="kt:inspired-pizza"/>
    <Literal>Margherita is subsumed by VegetarianPizza through the all-values restriction.</Literal>
  </DataPropertyAssertion>

</Ontology>
